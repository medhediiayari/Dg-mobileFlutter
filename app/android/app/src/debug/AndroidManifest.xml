<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Builds de développement : API locale en http (émulateur 10.0.2.2, IP du PC),
         voir res/xml/network_security_config.xml. Les builds release n'autorisent que
         https (et http vers 10.0.2.2 / localhost pour les essais sur émulateur). -->
    <application android:usesCleartextTraffic="true" />
</manifest>
